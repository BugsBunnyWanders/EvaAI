EVA_APP_NAME=Eva
EVA_ENVIRONMENT=local
EVA_LOG_LEVEL=INFO
EVA_LOG_FORMAT=console
EVA_DATABASE_URL=postgresql+psycopg://eva:eva@localhost:5432/eva
